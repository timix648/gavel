{
  "installCommand": "bun install",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/relay/:action",
      "destination": "/api/relay/:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-disputes",
      "schedule": "0 9 * * *"
    }
  ]
}